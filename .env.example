# First admin, created on first start when no admin exists. Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# TMDB v4 read access token (starts with eyJ) or v3 API key
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# Plex server and token. Inside Docker on Unraid, Plex runs with host networking.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=
# Comma-separated section titles or keys to scan; empty = all movie sections
PLEX_SECTIONS=

# Cron schedule for the Plex rescan + TMDB refresh; empty disables
SCAN_CRON=30 4 * * *

# Where the media share is mounted (for reading .nfo files); empty disables
MEDIA_ROOT=/media
# Prefixes stripped to make library-relative paths (Plex, Unraid, Windows share)
PATH_PREFIXES=/media/,/mnt/user/media/,/data/,M:/

# Local development only
# DATA_DIR=./data
