---
import { asc, desc, eq, sql } from 'drizzle-orm';
import { db } from '../db/client';
import { apiTokens, scanRuns, users } from '../db/schema';
import { createApiToken, createUser, setPassword } from '../lib/auth';
import { refreshStaleMovies } from '../lib/collection';
import { config } from '../lib/config';
import { back, int, str } from '../lib/forms';
import { getIdentity, getMovieSections, plexConfigured } from '../lib/plex/client';
import { scanInProgress, startScan } from '../lib/plex/scan';
import { searchMovies, tmdbConfigured } from '../lib/tmdb';
import Layout from '../layouts/Layout.astro';

const me = Astro.locals.user!;
const url = Astro.url;
let newToken: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = str(form, '_action');
  switch (action) {
    case 'scan': {
      if (!plexConfigured()) return back(url, { err: 'Plex is not configured.' });
      if (scanInProgress()) return back(url, { err: 'A scan is already running.' });
      void startScan('manual');
      return back(url, { ok: 'Scan started. Refresh this page to follow progress.' });
    }
    case 'refresh_tmdb': {
      void refreshStaleMovies(0, 5000).catch((e) => console.error('[tmdb] refresh failed', e));
      return back(url, { ok: 'Refreshing all movies from TMDB in the background.' });
    }
    case 'add_user': {
      const username = str(form, 'username');
      const password = str(form, 'password');
      const role = str(form, 'role') === 'admin' ? 'admin' : 'guest';
      if (!username || password.length < 8) return back(url, { err: 'Username and a password of at least 8 characters are required.' });
      if (db.select().from(users).where(eq(users.username, username)).get()) return back(url, { err: 'That username is taken.' });
      await createUser(username, password, role);
      return back(url, { ok: `Created ${role} "${username}".` });
    }
    case 'set_password': {
      const id = int(form, 'user_id');
      const password = str(form, 'password');
      if (!id || password.length < 8) return back(url, { err: 'Password must be at least 8 characters.' });
      await setPassword(id, password);
      return back(url, { ok: 'Password changed.' + (id === me.id ? ' Log in again.' : '') });
    }
    case 'delete_user': {
      const id = int(form, 'user_id');
      if (id === me.id) return back(url, { err: "You can't delete yourself." });
      if (id) db.delete(users).where(eq(users.id, id)).run();
      return back(url, { ok: 'User deleted.' });
    }
    case 'create_token': {
      const name = str(form, 'name');
      if (!name) return back(url, { err: 'Give the token a name.' });
      // Shown once, rendered directly instead of redirecting so it never lands in a URL.
      newToken = createApiToken(name);
      break;
    }
    case 'revoke_token': {
      const id = int(form, 'token_id');
      if (id) db.delete(apiTokens).where(eq(apiTokens.id, id)).run();
      return back(url, { ok: 'Token revoked.' });
    }
    default:
      return back(url, { err: 'Unknown action.' });
  }
}

// Connection status (only on explicit request, since it calls out to Plex/TMDB).
const test = url.searchParams.get('test') === '1';
let plexStatus = '';
let tmdbStatus = '';
if (test) {
  try {
    const id = await getIdentity();
    const sections = await getMovieSections();
    plexStatus = `✓ Plex ${id.version} · movie sections: ${sections.map((s) => `${s.title} (${s.key})`).join(', ') || 'none'}`;
  } catch (e) {
    plexStatus = `✗ ${(e as Error).message}`;
  }
  try {
    await searchMovies('Heat', 1995);
    tmdbStatus = '✓ TMDB OK';
  } catch (e) {
    tmdbStatus = `✗ ${(e as Error).message}`;
  }
}

const userRows = db.select().from(users).orderBy(asc(users.username)).all();
const tokenRows = db.select().from(apiTokens).orderBy(desc(apiTokens.createdAt)).all();
const runs = db.select().from(scanRuns).orderBy(desc(scanRuns.id)).limit(10).all();
const running = scanInProgress();
const lastLog = runs[0]?.log;
const fmt = (d: Date | null) => (d ? d.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '—');
const unsyncedCount = db.get<{ n: number }>(sql`select count(*) as n from movies where tmdb_synced_at is null`)?.n ?? 0;
---

<Layout title="Settings">
  <h1 class="mb-6 text-2xl font-semibold tracking-tight">Settings</h1>

  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Plex -->
    <section class="card p-5 lg:col-span-2">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold">Plex import</h2>
          <p class="text-sm text-ink-400">
            {plexConfigured() ? <>Server <code class="text-ink-300">{config.plexUrl}</code></> : 'Set PLEX_URL and PLEX_TOKEN to enable.'}
            {config.plexSections.length > 0 && <> · sections: {config.plexSections.join(', ')}</>}
            {config.scanCron && <> · scheduled <code class="text-ink-300">{config.scanCron}</code></>}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a class="btn" href="/settings?test=1">Test connections</a>
          <form method="post">
            <input type="hidden" name="_action" value="scan" />
            <button class="btn btn-primary" disabled={running || !plexConfigured()}>{running ? 'Scanning…' : 'Scan now'}</button>
          </form>
        </div>
      </div>
      {test && (
        <div class="mt-3 space-y-1 rounded-lg bg-ink-850 p-3 font-mono text-xs">
          <p>{plexStatus}</p>
          <p>{tmdbStatus}</p>
        </div>
      )}
      {runs.length > 0 && (
        <div class="mt-4 overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Started</th>
                <th>Trigger</th>
                <th>Status</th>
                <th>Items</th>
                <th>New movies</th>
                <th>New files</th>
                <th>Updated</th>
                <th>Missing</th>
                <th>Skipped / errors</th>
              </tr>
            </thead>
            <tbody>
              {runs.map((r) => (
                <tr>
                  <td>{fmt(r.startedAt)}</td>
                  <td class="text-ink-400">{r.trigger}</td>
                  <td class:list={[r.status === 'error' ? 'text-red-300' : r.status === 'running' ? 'text-amber-300' : 'text-emerald-300']}>{r.status}</td>
                  <td>{r.stats?.items ?? ''}</td>
                  <td>{r.stats?.newMovies ?? ''}</td>
                  <td>{r.stats?.newFiles ?? ''}</td>
                  <td>{r.stats?.updatedFiles ?? ''}</td>
                  <td>{r.stats?.missingFiles ?? ''}</td>
                  <td>{r.stats ? `${r.stats.skipped} / ${r.stats.errors}` : ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {lastLog && (
        <details class="mt-3">
          <summary class="cursor-pointer text-sm text-ink-400">Log of the latest scan</summary>
          <pre class="mt-2 max-h-80 overflow-auto rounded-lg bg-ink-950 p-3 text-xs text-ink-300">{lastLog}</pre>
        </details>
      )}
    </section>

    <!-- TMDB -->
    <section class="card p-5">
      <h2 class="text-lg font-semibold">TMDB</h2>
      <p class="mb-3 text-sm text-ink-400">
        {tmdbConfigured() ? `Language ${config.tmdbLanguage}.` : 'Set TMDB_API_KEY to enable metadata and posters.'}
        {unsyncedCount > 0 && ` ${unsyncedCount} movies have no TMDB metadata yet.`} Stale metadata is refreshed nightly.
      </p>
      <form method="post">
        <input type="hidden" name="_action" value="refresh_tmdb" />
        <button class="btn" disabled={!tmdbConfigured()}>Refresh all metadata now</button>
      </form>
    </section>

    <!-- API tokens -->
    <section class="card p-5">
      <h2 class="text-lg font-semibold">API tokens</h2>
      <p class="mb-3 text-sm text-ink-400">
        For media-pipeline and other scripts: <code class="text-ink-300">Authorization: Bearer &lt;token&gt;</code>
      </p>
      {newToken && (
        <div class="mb-3 rounded-lg border border-emerald-800 bg-emerald-950/50 p-3 text-sm">
          <p class="mb-1 text-emerald-200">Copy this token now. It won't be shown again:</p>
          <code class="block select-all break-all rounded bg-ink-950 p-2 font-mono text-xs">{newToken}</code>
        </div>
      )}
      <ul class="mb-3 divide-y divide-ink-800">
        {tokenRows.map((t) => (
          <li class="flex items-center justify-between gap-2 py-2 text-sm">
            <span>
              {t.name}
              <span class="block text-xs text-ink-500">created {fmt(t.createdAt)} · last used {fmt(t.lastUsedAt)}</span>
            </span>
            <form method="post" onsubmit="return confirm('Revoke this token?')">
              <input type="hidden" name="_action" value="revoke_token" />
              <input type="hidden" name="token_id" value={t.id} />
              <button class="btn btn-sm btn-danger">Revoke</button>
            </form>
          </li>
        ))}
      </ul>
      <form method="post" class="flex gap-2">
        <input type="hidden" name="_action" value="create_token" />
        <input name="name" placeholder="Token name, e.g. media-pipeline" required class="flex-1" />
        <button class="btn">Create</button>
      </form>
    </section>

    <!-- Users -->
    <section class="card p-5 lg:col-span-2">
      <h2 class="text-lg font-semibold">Users</h2>
      <p class="mb-3 text-sm text-ink-400">Guests can browse the collection and wishlist, but can't edit and never see ownership or file details.</p>
      <ul class="mb-4 divide-y divide-ink-800">
        {userRows.map((u) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-2.5 text-sm">
            <span>
              <span class="font-medium">{u.username}</span>
              <span class:list={['chip ml-2', u.role === 'admin' ? 'bg-accent text-ink-950' : 'bg-ink-700 text-ink-300']}>{u.role}</span>
              {u.id === me.id && <span class="ml-2 text-xs text-ink-500">(you)</span>}
            </span>
            <div class="flex flex-wrap gap-2">
              <form method="post" class="flex gap-2">
                <input type="hidden" name="_action" value="set_password" />
                <input type="hidden" name="user_id" value={u.id} />
                <input type="password" name="password" placeholder="New password" minlength="8" required autocomplete="new-password" class="w-40" />
                <button class="btn btn-sm">Set password</button>
              </form>
              {u.id !== me.id && (
                <form method="post" onsubmit="return confirm('Delete this user?')">
                  <input type="hidden" name="_action" value="delete_user" />
                  <input type="hidden" name="user_id" value={u.id} />
                  <button class="btn btn-sm btn-danger">Delete</button>
                </form>
              )}
            </div>
          </li>
        ))}
      </ul>
      <form method="post" class="flex flex-wrap gap-2">
        <input type="hidden" name="_action" value="add_user" />
        <input name="username" placeholder="Username" required autocomplete="off" />
        <input type="password" name="password" placeholder="Password (8+ chars)" minlength="8" required autocomplete="new-password" />
        <select name="role">
          <option value="guest">Guest (read-only)</option>
          <option value="admin">Admin</option>
        </select>
        <button class="btn">Add user</button>
      </form>
    </section>
  </div>
</Layout>
